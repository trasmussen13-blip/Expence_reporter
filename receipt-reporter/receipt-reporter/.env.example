# Kopiér eventuelt værdierne til din servers miljø.
PORT=5000
OLLAMA_HOST=http://127.0.0.1:11434
SESSION_SECRET=change-this-to-a-long-random-value

# OAuth-login til den lokale server.
# Registrér disse redirect-URLs hos hver udbyder:
# http://127.0.0.1:5000/auth/callback/google
# http://127.0.0.1:5000/auth/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Brug denne hvis appen tilgås via et fast hostname:
# OAUTH_REDIRECT_BASE_URL=https://kvitteringer.example.local
# Sæt COOKIE_SECURE=true når serveren kun bruger HTTPS.
COOKIE_SECURE=false